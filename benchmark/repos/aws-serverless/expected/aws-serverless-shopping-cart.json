{
  "version": 5,
  "repository": "aws-serverless-shopping-cart",
  "concepts": [
    {
      "key": "shopping-cart-system",
      "identityTerms": ["shopping", "cart"],
      "type": "System",
      "requiredMetadata": [],
      "requiredSourcePaths": ["README.md"]
    },
    {
      "key": "shopping-cart-service",
      "identityTerms": ["shopping", "cart", "service"],
      "type": "Service",
      "requiredMetadata": [],
      "requiredSourcePaths": ["backend/shoppingcart-service.yaml"]
    },
    {
      "key": "shopping-cart-api",
      "identityTerms": ["shopping", "cart", "api"],
      "type": "API Surface",
      "requiredMetadata": [],
      "requiredSourcePaths": ["backend/shoppingcart-service.yaml", "frontend/src/backend/api.js"]
    },
    {
      "key": "shopping-cart-infrastructure",
      "identityTerms": ["shopping", "cart", "infrastructure"],
      "type": "Infrastructure Definition",
      "requiredMetadata": ["configuration_root", "declared_resources"],
      "requiredSourcePaths": ["backend/shoppingcart-service.yaml"]
    },
    {
      "key": "dynamodb-shopping-cart-table",
      "identityTerms": ["cart", "table"],
      "type": "Database Table",
      "requiredMetadata": ["resource_name", "keys"],
      "requiredSourcePaths": ["backend/shoppingcart-service.yaml", "backend/shopping-cart-service/migrate_cart.py"]
    },
    {
      "key": "cart-delete-sqs-queue",
      "identityTerms": ["cart", "queue"],
      "type": "AWS SQS Queue",
      "requiredMetadata": ["resource_name"],
      "requiredSourcePaths": ["backend/shoppingcart-service.yaml", "backend/shopping-cart-service/migrate_cart.py"]
    },
    {
      "key": "authenticated-cart-migration",
      "identityTerms": ["authenticated", "migration"],
      "type": "Business Flow",
      "requiredMetadata": ["business_purpose", "trigger", "outcome"],
      "requiredSourcePaths": ["frontend/src/backend/api.js", "backend/shopping-cart-service/migrate_cart.py"]
    }
  ],
  "relationships": [
    { "from": "shopping-cart-system", "to": "shopping-cart-service", "kind": "composed-of" },
    { "from": "shopping-cart-system", "to": "shopping-cart-api", "kind": "exposes" },
    { "from": "shopping-cart-api", "to": "shopping-cart-service", "kind": "provided-by" },
    { "from": "shopping-cart-infrastructure", "to": "dynamodb-shopping-cart-table", "kind": "declares" },
    { "from": "shopping-cart-infrastructure", "to": "cart-delete-sqs-queue", "kind": "declares" },
    { "from": "authenticated-cart-migration", "to": "shopping-cart-api", "kind": "step" },
    { "from": "authenticated-cart-migration", "to": "cart-delete-sqs-queue", "kind": "step" }
  ]
}
