{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.test.ts",
    "src/app/hub-okf/ci/standalone.ts",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["vendor/**"],
  "ignoreDependencies": ["@swc/core"],
  "ignoreBinaries": ["gitleaks", "patch"],
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
