{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.test.ts",
    "src/app/hub-okf/ci/standalone.ts",
    "scripts/**/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": [
    "@swc/core",
    "cytoscape"
  ],
  "ignoreBinaries": [
    "gitleaks"
  ],
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
