+static bool ws_ends_with(const char *value, const char *suffix) {
+    size_t value_len = strlen(value);
+    size_t suffix_len = strlen(suffix);
+    return value_len >= suffix_len && strcmp(value + value_len - suffix_len, suffix) == 0;
+}
+
+bool cbm_workspace_path_is_agentbase_denied(const char *relative_path) {
+    if (!relative_path || !relative_path[0]) {
+        return true;
+    }
+    size_t length = strlen(relative_path);
+    if (length >= 4096U) {
+        return true;
+    }
+    char lowered[4096];
+    for (size_t i = 0; i <= length; i++) {
+        unsigned char c = (unsigned char)relative_path[i];
+        lowered[i] = ws_is_sep((char)c) ? '/' : (char)tolower(c);
+    }
+
+    static const char *denied_dirs[] = {
+        ".git", ".agentbase", ".codebase-memory", "node_modules", "vendor", "dist",
+        "build", "coverage", "target", ".terraform", ".cache", ".next", ".nuxt",
+        "__pycache__", NULL,
+    };
+    const char *cursor = lowered;
+    while (*cursor) {
+        const char *end = strchr(cursor, '/');
+        size_t component_len = end ? (size_t)(end - cursor) : strlen(cursor);
+        if (component_len == 0U || (component_len == 1U && cursor[0] == '.') ||
+            (component_len == 2U && cursor[0] == '.' && cursor[1] == '.')) {
+            return true;
+        }
+        for (int i = 0; denied_dirs[i]; i++) {
+            if (strlen(denied_dirs[i]) == component_len &&
+                strncmp(cursor, denied_dirs[i], component_len) == 0) {
+                return true;
+            }
+        }
+        if (!end) {
+            break;
+        }
+        cursor = end + 1;
+    }
+
+    const char *name = strrchr(lowered, '/');
+    name = name ? name + 1 : lowered;
+    if (strcmp(name, ".env") == 0 || strncmp(name, ".env.", 5U) == 0 ||
+        ws_ends_with(name, ".env") || strcmp(name, ".netrc") == 0 ||
+        strcmp(name, ".npmrc") == 0 || strcmp(name, ".pypirc") == 0 ||
+        strcmp(name, "credentials") == 0 || strcmp(name, "credentials.json") == 0 ||
+        strcmp(name, "id_rsa") == 0 || strcmp(name, "id_ed25519") == 0 ||
+        ws_ends_with(name, ".pem") || ws_ends_with(name, ".key") ||
+        ws_ends_with(name, ".p12") || ws_ends_with(name, ".pfx") ||
+        ws_ends_with(name, ".crt") || ws_ends_with(name, ".cer")) {
+        return true;
+    }
+    return false;
+}
