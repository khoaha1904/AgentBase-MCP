+static void filter_unavailable_grammars(cbm_pipeline_t *p, cbm_file_info_t *files, int *count) {
+    int retained = 0;
+    for (int i = 0; i < *count; i++) {
+        if (!cbm_ts_language(files[i].language)) {
+            cbm_pipeline_add_file_error(p, files[i].rel_path,
+                                        "language not enabled by AgentBase parser profile",
+                                        "unsupported");
+            free(files[i].path);
+            free(files[i].rel_path);
+            continue;
+        }
+        if (retained != i) {
+            files[retained] = files[i];
+        }
+        retained++;
+    }
+    if (retained != *count) {
+        cbm_log_info("pipeline.parser_profile", "retained", itoa_buf(retained), "unsupported",
+                     itoa_buf(*count - retained));
+    }
+    *count = retained;
+}
