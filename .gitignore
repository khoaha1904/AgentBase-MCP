.idea/
.vscode/

# Local credentials and configuration must never enter the repository.
.env
.env.*

# Local detailed graphs are disposable machine state, not shared knowledge.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
local-graphs/

# AgentBase-owned evidence, proposals and recovery state are disposable/local.
.agentbase/

# Ignore caches from independently installed external graph tools.
.codebase-memory/

# Same-filesystem OKF switch siblings are local recovery machinery. The shared
# okf/ directory itself remains visible to Git.
.agentbase-okf-next-*/
.agentbase-okf-backup-*/

# Superseded documentation is kept locally for reference. Current, portable
# documentation lives in the tracked files directly under docs/ and
