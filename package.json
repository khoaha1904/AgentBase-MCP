{
  "name": "agentbase-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "AgentBase-MCP for local Code Graph access and governed AgentBase-Hub OKF knowledge",
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "spec:check": "node scripts/checks/check-specs.mjs",
    "configure:hub-token": "node scripts/installation/configure-hub-token.mjs",
    "build:hub-validator": "node scripts/build-hub-validator.mjs",
    "check:hub-validator": "node scripts/build-hub-validator.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "gitleaks": "gitleaks detect --no-git --redact --config .gitleaks.toml",
    "test": "node scripts/checks/run-tests.mjs",
    "test:code-intelligence": "node --test src/core/code-intelligence/contract.test.ts",
    "test:fake-provider": "node --test src/providers/fake-code-intelligence/fake-provider.test.ts",
    "test:foundation-demo": "node --test src/app/foundation-demo/run-demo.test.ts",
    "demo": "node src/cli.ts",
    "integration:codebase-memory": "node src/cli.ts codebase-memory:integration",
    "benchmark:codebase-memory": "node src/cli.ts codebase-memory:benchmark",
    "benchmark:okf": "node scripts/benchmark/benchmark-okf.mjs",
    "check": "npm run spec:check && npm run check:hub-validator && npm run typecheck && npm run depcruise && npm run knip && npm run gitleaks && npm test",
    "verify": "npm run check && git diff --check"
  },
  "devDependencies": {
    "@swc/core": "1.16.0",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "knip": "6.32.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "codebase-memory-mcp": "0.10.1",
    "yaml": "2.9.0"
  },
  "allowScripts": {
    "codebase-memory-mcp@0.10.1": true,
    "@swc/core@1.16.0": true
  }
}
