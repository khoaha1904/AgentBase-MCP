    { "type": "AWS Lambda", "signals": ["aws lambda function", "Lambda resource or runtime identity"] },
    { "type": "AWS SQS Queue", "signals": ["aws sqs queue", "SQS resource identity", "producer or consumer evidence"] },
    { "type": "Terraform Module", "signals": ["terraform module", "module source or module root evidence"] },
    { "type": "Business Flow", "signals": ["business flow", "trigger", "observable outcome", "supporting system evidence"] },
