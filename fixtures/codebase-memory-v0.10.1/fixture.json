{
  "formatVersion": 1,
  "provider": {
    "name": "codebase-memory-mcp",
    "version": "0.10.1",
    "invocation": "managed-package-private-native-cli",
    "responseEnvelope": {
      "content": "array of MCP content blocks",
      "structuredContent": "optional object; preferred when present",
      "isError": "boolean"
    }
  },
  "commands": [
    {
      "operation": "index",
      "tool": "index_repository",
      "requiredArguments": ["repo_path"],
      "fixedArguments": {
        "mode": "fast",
        "name": "agentbase-typescript-fixture",
        "persistence": false
      },
      "response": "responses/index.json"
    },
    {
      "operation": "architecture",
      "tool": "get_architecture",
      "requiredArguments": ["project"],
      "response": "responses/architecture.json",
      "limitation": "tree output may omit structuredContent and must be parsed as bounded text"
    },
    {
      "operation": "search",
      "tool": "search_graph",
      "requiredArguments": ["project", "query"],
      "fixedArguments": {
        "label": "Function",
        "limit": 10,
        "format": "json"
      },
      "response": "responses/search-inspect-workspace.json"
    },
    {
      "operation": "trace",
      "tool": "trace_path",
      "requiredArguments": ["project", "function_name"],
      "fixedArguments": {
        "direction": "outbound",
        "depth": 1,
        "limit": 20,
        "mode": "calls",
        "format": "json"
      },
      "response": "responses/trace-inspect-workspace.json"
    },
    {
      "operation": "snippet",
      "tool": "get_code_snippet",
      "requiredArguments": ["project", "qualified_name"],
      "fixedArguments": {
        "include_neighbors": false
      },
      "responses": [
        "responses/snippet-inspect-workspace.json",
        "responses/snippet-resolve-workspace.json",
        "responses/snippet-list-modules.json"
      ]
    }
  ],
  "acceptedTask": {
    "task": "Trace the inspectWorkspace flow across its public catalog and workspace boundaries",
    "maximumSourceFiles": 3,
    "sourceFiles": [
      "src/app/inspect.ts",
      "src/catalog/repository.ts",
      "src/workspace/paths.ts"
    ],
    "criticalFacts": [
      {
        "id": "search:agentbase-typescript-fixture.src.app.inspect.inspectWorkspace",
        "statement": "inspectWorkspace is a Function in src/app/inspect.ts at lines 4-6",
        "evidence": ["search:inspectWorkspace", "snippet:inspectWorkspace"]
      },
      {
        "id": "trace:inspectWorkspace:agentbase-typescript-fixture.src.catalog.repository.listModules",
        "statement": "inspectWorkspace calls catalog listModules at hop 1",
        "evidence": ["trace:inspectWorkspace:listModules", "snippet:listModules"]
      },
      {
        "id": "trace:inspectWorkspace:agentbase-typescript-fixture.src.workspace.paths.resolveWorkspace",
        "statement": "inspectWorkspace calls workspace resolveWorkspace at hop 1",
        "evidence": ["trace:inspectWorkspace:resolveWorkspace", "snippet:resolveWorkspace"]
      },
      {
        "id": "architecture:boundary:app:catalog",
        "statement": "The architecture reports an app-to-catalog call boundary",
        "evidence": ["architecture:boundary:app:catalog"]
      },
      {
        "id": "architecture:boundary:app:workspace",
        "statement": "The architecture reports an app-to-workspace call boundary",
        "evidence": ["architecture:boundary:app:workspace"]
      }
    ],
    "expectedCoverage": {
      "criticalFacts": 5,
      "requiredFactsFound": 5,
      "percentage": 100
    }
  },
  "normalization": {
    "qualifiedNames": "retain stable explicit project prefix in local evidence",
    "filePaths": "verify containment then convert absolute provider paths to repository-relative POSIX paths",
    "rowModels": "map provider cols arrays to named fields before domain validation",
    "ordering": "sort normalized facts by operation, repository-relative path, line and qualified name",
    "diagnostics": "strip absolute roots, pids, timestamps, allocator logs and temporary-process hints from shared fixtures",
    "continuity": "provider rows are evidence input; previous OKF prose is never inserted here"
  },
  "failureFixtures": [
    {
      "name": "invalid trace direction",
      "response": "responses/error-invalid-direction.json",
      "expected": "typed provider-input failure; no fallback or retry with another direction"
    }
  ]
}
